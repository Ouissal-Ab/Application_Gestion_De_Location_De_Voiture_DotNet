@model FrontOffice.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="auth-container">
    <h2>📝 Créer un compte client</h2>
    <hr />

    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="FirstName" class="form-label">Prénom</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Votre prénom" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="LastName" class="form-label">Nom</label>
                    <input asp-for="LastName" class="form-control" placeholder="Votre nom" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" type="email" placeholder="votre.email@exemple.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Phone" class="form-label">Téléphone</label>
            <input asp-for="Phone" class="form-control" placeholder="0612345678" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Password" class="form-label">Mot de passe</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="Votre mot de passe" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirmer le mot de passe</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirmez votre mot de passe" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <button type="submit" class="btn btn-primary w-100 btn-lg">Créer mon compte</button>
        </div>
        
        <div class="text-center">
            <a asp-action="Login" class="btn btn-link">Vous avez déjà un compte ? Se connecter</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

