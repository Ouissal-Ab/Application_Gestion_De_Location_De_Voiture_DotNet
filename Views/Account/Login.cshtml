@model FrontOffice.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="auth-container">
    <h2>🔐 Connexion</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group mb-3">
            <label asp-for="UserType" class="form-label">Type de compte</label>
            <select asp-for="UserType" class="form-control">
                <option value="Client">👤 Client</option>
                <option value="Admin">👨‍💼 Administrateur</option>
            </select>
            <span asp-validation-for="UserType" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="EmailOrUsername" class="form-label">Email ou nom d'utilisateur</label>
            <input asp-for="EmailOrUsername" class="form-control" placeholder="Entrez votre email ou nom d'utilisateur" />
            <span asp-validation-for="EmailOrUsername" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Password" class="form-label">Mot de passe</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="Entrez votre mot de passe" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <button type="submit" class="btn btn-primary w-100 btn-lg">Se connecter</button>
        </div>
        
        <div class="text-center">
            <a asp-action="Register" class="btn btn-link">Vous n'avez pas de compte ? Créer un compte</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

