@{
    ViewData["Title"] = "Accueil";
    var userType = Context.Session.GetString("UserType");
    var username = Context.Session.GetString("Username");
}

<div class="text-center py-5">
    <h1 class="display-4 mb-4">🚗 Système de Location de Voitures</h1>
    <p class="lead mb-4">Trouvez la voiture parfaite pour votre prochain voyage</p>
    
    @if (!string.IsNullOrEmpty(userType))
    {
        <div class="alert alert-info" style="max-width: 600px; margin: 2rem auto;">
            <h5>Bienvenue, @username!</h5>
            <p>Vous êtes connecté en tant que <strong>@userType</strong></p>
        </div>
        @if (userType == "Client")
        {
            <div class="mt-3">
                <a asp-controller="Vehicles" asp-action="Index" class="btn btn-primary btn-lg me-3 px-4">
                    🚙 Voir les véhicules disponibles
                </a>
                <a asp-controller="Rentals" asp-action="Index" class="btn btn-outline-primary btn-lg px-4">
                    📋 Mes Réservations
                </a>
            </div>
        }
        @if (userType == "Admin")
        {
            <div class="mt-3">
                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary btn-lg me-3 px-4">
                    👨‍💼 Tableau de bord Admin
                </a>
                <a asp-controller="Admin" asp-action="Vehicles" class="btn btn-outline-primary btn-lg me-3 px-4">
                    🚗 Gérer les véhicules
                </a>
                <a asp-controller="Admin" asp-action="Clients" class="btn btn-outline-info btn-lg me-3 px-4">
                    👥 Gérer les clients
                </a>
                <a asp-controller="Admin" asp-action="Rentals" class="btn btn-outline-warning btn-lg px-4">
                    📋 Gérer les locations
                </a>
            </div>
        }
    }
    else
    {
        <div class="mt-4">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg me-3 px-4">Se connecter</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4">Créer un compte</a>
        </div>
    }
</div>

@if (string.IsNullOrEmpty(userType))
{
    <div class="row mt-5">
        <div class="col-md-4 text-center mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3>🔍</h3>
                    <h5 class="card-title">Recherchez</h5>
                    <p class="card-text">Parcourez notre large sélection de véhicules disponibles</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-center mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3>📅</h3>
                    <h5 class="card-title">Réservez</h5>
                    <p class="card-text">Choisissez vos dates et réservez en quelques clics</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-center mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h3>🚗</h3>
                    <h5 class="card-title">Profitez</h5>
                    <p class="card-text">Prenez la route et profitez de votre voyage</p>
                </div>
            </div>
        </div>
    </div>
}
