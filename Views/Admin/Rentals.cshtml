@model IEnumerable<Data.Entities.Rental>
@{
    ViewData["Title"] = "Gestion des Locations";
}

<div class="container-fluid">
    <h1 class="mb-4">📋 Gestion des Locations</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Client</th>
                    <th>Véhicule</th>
                    <th>Date début</th>
                    <th>Date fin</th>
                    <th>Durée</th>
                    <th>Montant</th>
                    <th>Statut</th>
                    <th>Date création</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rental in Model)
                {
                    var days = (rental.EndDate - rental.StartDate).Days;
                    <tr>
                        <td>@rental.Id</td>
                        <td>@rental.Client.FirstName @rental.Client.LastName</td>
                        <td>@rental.Vehicle.Brand @rental.Vehicle.Model</td>
                        <td>@rental.StartDate.ToString("dd/MM/yyyy")</td>
                        <td>@rental.EndDate.ToString("dd/MM/yyyy")</td>
                        <td>@days jour(s)</td>
                        <td>@rental.TotalAmount.ToString("C")</td>
                        <td>
                            @switch (rental.Status)
                            {
                                case "Pending":
                                    <span class="badge bg-warning">En attente</span>
                                    break;
                                case "Confirmed":
                                    <span class="badge bg-success">Confirmée</span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-info">Terminée</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger">Annulée</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@rental.Status</span>
                                    break;
                            }
                        </td>
                        <td>@rental.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a asp-action="RentalDetails" asp-route-id="@rental.Id" class="btn btn-sm btn-primary">📄 Détails</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Aucune location enregistrée.
        </div>
    }
</div>

