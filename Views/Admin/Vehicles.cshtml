@model IEnumerable<Data.Entities.Vehicle>
@{
    ViewData["Title"] = "Gestion des Véhicules";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🚗 Gestion des Véhicules</h1>
        <a asp-action="CreateVehicle" class="btn btn-primary">➕ Ajouter un véhicule</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Marque</th>
                    <th>Modèle</th>
                    <th>Année</th>
                    <th>Couleur</th>
                    <th>Plaque</th>
                    <th>Tarif/jour</th>
                    <th>Disponible</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var vehicle in Model)
                {
                    <tr>
                        <td>@vehicle.Id</td>
                        <td>@vehicle.Brand</td>
                        <td>@vehicle.Model</td>
                        <td>@vehicle.Year</td>
                        <td>@vehicle.Color</td>
                        <td>@vehicle.LicensePlate</td>
                        <td>@vehicle.DailyRate.ToString("C")</td>
                        <td>
                            @if (vehicle.IsAvailable)
                            {
                                <span class="badge bg-success">✓ Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">✗ Indisponible</span>
                            }
                        </td>
                        <td>
                            <a asp-action="EditVehicle" asp-route-id="@vehicle.Id" class="btn btn-sm btn-warning">✏️ Modifier</a>
                            <form asp-action="DeleteVehicle" asp-route-id="@vehicle.Id" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce véhicule ?');">
                                <button type="submit" class="btn btn-sm btn-danger">🗑️ Supprimer</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Aucun véhicule enregistré. <a asp-action="CreateVehicle">Créer le premier véhicule</a>
        </div>
    }
</div>

