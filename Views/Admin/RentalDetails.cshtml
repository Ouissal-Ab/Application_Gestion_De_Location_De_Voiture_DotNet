@model Data.Entities.Rental
@{
    ViewData["Title"] = "Détails de la Location";
    var days = (Model.EndDate - Model.StartDate).Days;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📄 Détails de la Location #@Model.Id</h1>
        <a asp-action="Rentals" class="btn btn-secondary">← Retour</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5>👤 Informations Client</h5>
                </div>
                <div class="card-body">
                    <p><strong>Nom:</strong> @Model.Client.FirstName @Model.Client.LastName</p>
                    <p><strong>Email:</strong> @Model.Client.Email</p>
                    <p><strong>Téléphone:</strong> @Model.Client.Phone</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h5>🚗 Informations Véhicule</h5>
                </div>
                <div class="card-body">
                    <p><strong>Véhicule:</strong> @Model.Vehicle.Brand @Model.Vehicle.Model</p>
                    <p><strong>Année:</strong> @Model.Vehicle.Year</p>
                    <p><strong>Couleur:</strong> @Model.Vehicle.Color</p>
                    <p><strong>Plaque:</strong> @Model.Vehicle.LicensePlate</p>
                    <p><strong>Tarif journalier:</strong> @Model.Vehicle.DailyRate.ToString("C")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header bg-warning text-dark">
            <h5>📅 Détails de la Location</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <p><strong>Date de début:</strong> @Model.StartDate.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-md-4">
                    <p><strong>Date de fin:</strong> @Model.EndDate.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-md-4">
                    <p><strong>Durée:</strong> @days jour(s)</p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Montant total:</strong> <span class="fs-4 text-success">@Model.TotalAmount.ToString("C")</span></p>
                </div>
                <div class="col-md-6">
                    <p><strong>Statut:</strong> 
                        @switch (Model.Status)
                        {
                            case "Pending":
                                <span class="badge bg-warning">En attente</span>
                                break;
                            case "Confirmed":
                                <span class="badge bg-success">Confirmée</span>
                                break;
                            case "Completed":
                                <span class="badge bg-info">Terminée</span>
                                break;
                            case "Cancelled":
                                <span class="badge bg-danger">Annulée</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@Model.Status</span>
                                break;
                        }
                    </p>
                </div>
            </div>
            <p><strong>Date de création:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.QrCodeData))
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5>📱 QR Code</h5>
            </div>
            <div class="card-body text-center">
                <img src="@Url.Action("QrCode", "Rentals", new { id = Model.Id })" alt="QR Code" class="img-fluid" style="max-width: 200px;" />
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header bg-dark text-white">
            <h5>⚙️ Modifier le Statut</h5>
        </div>
        <div class="card-body">
            <form asp-action="UpdateRentalStatus" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="row">
                    <div class="col-md-6">
                        <select name="status" class="form-select mb-3">
                            <option value="Pending" selected="@(Model.Status == "Pending")">En attente</option>
                            <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Confirmée</option>
                            <option value="Completed" selected="@(Model.Status == "Completed")">Terminée</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Annulée</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <button type="submit" class="btn btn-primary">✅ Mettre à jour</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

