@model Data.Entities.Vehicle
@{
    ViewData["Title"] = "Modifier un Véhicule";
}

<div class="container">
    <h1 class="mb-4">✏️ Modifier un Véhicule</h1>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="EditVehicle" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Brand" class="form-label">Marque *</label>
                    <input asp-for="Brand" class="form-control" required />
                    <span asp-validation-for="Brand" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Model" class="form-label">Modèle *</label>
                    <input asp-for="Model" class="form-control" required />
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Year" class="form-label">Année *</label>
                    <input asp-for="Year" class="form-control" type="number" min="1900" max="@(DateTime.Now.Year + 1)" required />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Color" class="form-label">Couleur *</label>
                    <input asp-for="Color" class="form-control" required />
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LicensePlate" class="form-label">Plaque d'immatriculation *</label>
                    <input asp-for="LicensePlate" class="form-control" required />
                    <span asp-validation-for="LicensePlate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DailyRate" class="form-label">Tarif journalier (€) *</label>
                    <input asp-for="DailyRate" class="form-control" type="number" step="0.01" min="0" required />
                    <span asp-validation-for="DailyRate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="IsAvailable" class="form-check-input" type="checkbox" />
                        <label asp-for="IsAvailable" class="form-check-label">Disponible</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">✅ Enregistrer</button>
                    <a asp-action="Vehicles" class="btn btn-secondary">❌ Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

